# Copy to .env and fill in. Only the first block is required to run the store;
# the rest switch on optional services. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# A MongoDB replica set (product writes use transactions): MongoDB Atlas, or a
# local `mongod --replSet`. For a quick local try: `npm run dev:db` prints one.
MONGODB_URI=
# Secrets for signing login tokens — long random strings, different from each other.
AccessTokenPrivateKey=
RefreshTokenPrivateKey=
# Public URL of the store (no trailing slash), used in SEO, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Image uploads (ImageKit) ──────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ── Email (order confirmations, password reset, ticket replies) ───────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Store <noreply@example.com>"
ADMIN_EMAIL=
# A PNG/JPG logo URL for emails (many mail clients don't render SVG).
NEXT_PUBLIC_LOGO_URL=

# ── Scheduled jobs (Vercel Cron → /api/cron/*) ────────────────────────────────
CRON_SECRET=

# ── Optional features (each also needs its switch in store.config.js) ─────────
# features.googleAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# features.push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# features.aiAssistant / features.aiProductDraft
GEMINI_API_KEY=
# Shared AI layer (src/lib/ai): gemini (default) | openai
AI_PROVIDER=
GEMINI_PROXY_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# features.warehouse — a separate warehouse database
MONGODB_URI_WAREHOUSE=
# Microsoft Clarity analytics (production only; empty = off)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
GEMINI_MODEL=
ADMIN_ASSISTANT_ENABLED=
# Set when behind a reverse proxy you trust (client IP for rate limiting).
TRUSTED_PROXY=
# auto (default) | enabled | disabled — MongoDB transaction detection
MONGODB_TRANSACTIONS=
